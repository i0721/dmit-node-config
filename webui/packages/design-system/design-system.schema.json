{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://community-go.dev/schemas/design-system/v1",
  "title": "Design System Authority Schema",
  "description": "Design System Token 与 Motion Language 事实的唯一 Schema-Controlled Source；生成物 tokens.css（受控区段）与 motion.css（整文件）由 @community-go/schemas/runtime 内置 Generator 产出。x-community-go 是正式注册的 extension keyword，实例结构由 $defs.authorityMeta / $defs.authoritySource 定义。",
  "type": "object",
  "required": ["x-community-go"],
  "properties": {
    "x-community-go": {
      "$ref": "#/$defs/authorityMeta"
    }
  },
  "additionalProperties": true,
  "$defs": {
    "authorityMeta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocolVersion",
        "authorityId",
        "contractRef",
        "source",
        "facts",
        "authoring",
        "artifacts"
      ],
      "properties": {
        "protocolVersion": {
          "const": 1
        },
        "authorityId": {
          "type": "string",
          "minLength": 1
        },
        "contractRef": {
          "type": "object",
          "additionalProperties": false,
          "required": ["file", "pointer"],
          "properties": {
            "file": {
              "type": "string",
              "minLength": 1
            },
            "pointer": {
              "type": "string",
              "pattern": "^/"
            }
          }
        },
        "source": {
          "$ref": "#/$defs/authoritySource"
        },
        "facts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "sourcePointer"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string"
              },
              "sourcePointer": {
                "type": "string",
                "pattern": "^/x-community-go/source/"
              },
              "implementation": {
                "type": "string"
              },
              "evidence": {
                "type": "string"
              }
            }
          }
        },
        "authoring": {
          "type": "object",
          "additionalProperties": false,
          "required": ["patchableSourcePointers"],
          "properties": {
            "patchableSourcePointers": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^/x-community-go/source/"
              }
            }
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["target", "generator", "options"],
            "properties": {
              "target": {
                "type": "string",
                "minLength": 1
              },
              "generator": {
                "type": "string",
                "enum": ["css-token-regions-v1", "css-motion-language-v1"]
              },
              "options": {
                "type": "object"
              }
            }
          }
        }
      }
    },
    "authoritySource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "motionLanguage"],
      "properties": {
        "tokens": {
          "$ref": "#/$defs/tokenSource"
        },
        "motionLanguage": {
          "$ref": "#/$defs/motionLanguageSource"
        }
      }
    },
    "tokenSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["colors", "accents", "theme", "rootMotion", "appearanceProfiles"],
      "properties": {
        "colors": {
          "$ref": "#/$defs/colorSource"
        },
        "accents": {
          "$ref": "#/$defs/accentSource"
        },
        "theme": {
          "$ref": "#/$defs/themeSource"
        },
        "rootMotion": {
          "$ref": "#/$defs/rootMotionSource"
        },
        "appearanceProfiles": {
          "$ref": "#/$defs/appearanceProfiles"
        }
      }
    },
    "colorSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roleOrder", "light", "dark"],
      "properties": {
        "roleOrder": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "light": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cssValue"
          }
        },
        "dark": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cssValue"
          }
        }
      }
    },
    "accentSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["order", "roles", "palettes"],
      "properties": {
        "order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "roles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "palettes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": ["light", "dark"],
            "properties": {
              "light": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/cssValue"
                }
              },
              "dark": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/cssValue"
                }
              }
            }
          }
        }
      }
    },
    "themeSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fontSans",
        "radii",
        "spacings",
        "shadows",
        "easeProduct",
        "defaultTransitionDuration",
        "transitionDurations",
        "zIndices"
      ],
      "properties": {
        "fontSans": {
          "type": "string",
          "minLength": 1
        },
        "radii": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cssValue"
          }
        },
        "spacings": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cssValue"
          }
        },
        "shadows": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cssValue"
          }
        },
        "easeProduct": {
          "type": "string",
          "minLength": 1
        },
        "defaultTransitionDuration": {
          "$ref": "#/$defs/tokenNode"
        },
        "transitionDurations": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/tokenNode"
          }
        },
        "zIndices": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cssValue"
          }
        }
      }
    },
    "rootMotionSource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "debugScale",
        "delayRoute",
        "delayReveal",
        "revealOpacity",
        "durationBase",
        "durationPurpose",
        "durationProgress",
        "distances"
      ],
      "properties": {
        "debugScale": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doc", "value"],
          "properties": {
            "doc": {
              "$ref": "#/$defs/commentParagraphs"
            },
            "value": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "delayRoute": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doc", "values"],
          "properties": {
            "doc": {
              "$ref": "#/$defs/commentParagraphs"
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/tokenNode"
              }
            }
          }
        },
        "delayReveal": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/cssValue" }
        },
        "revealOpacity": { "$ref": "#/$defs/cssValue" },
        "durationBase": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/cssValue"
          }
        },
        "durationPurpose": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doc", "refs"],
          "properties": {
            "doc": {
              "$ref": "#/$defs/commentParagraphs"
            },
            "refs": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["ref", "doc"],
                "properties": {
                  "ref": {
                    "$ref": "#/$defs/sourceRef"
                  },
                  "doc": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "durationProgress": {
          "type": "object",
          "additionalProperties": false,
          "required": ["doc", "values"],
          "properties": {
            "doc": {
              "$ref": "#/$defs/commentParagraphs"
            },
            "values": {
              "type": "object",
              "additionalProperties": {
                "anyOf": [
                  {
                    "$ref": "#/$defs/cssValue"
                  },
                  {
                    "$ref": "#/$defs/tokenNode"
                  }
                ]
              }
            }
          }
        },
        "distances": {
          "type": "object",
          "additionalProperties": false,
          "required": ["values"],
          "properties": {
            "values": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": ["value", "doc"],
                "properties": {
                  "value": {
                    "$ref": "#/$defs/cssValue"
                  },
                  "doc": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "tokenNode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {
          "$ref": "#/$defs/sourceRef"
        },
        "doc": {
          "type": "string"
        }
      }
    },
    "cssValue": {
      "type": "string",
      "minLength": 1
    },
    "sourceRef": {
      "type": "string",
      "pattern": "^/x-community-go/source/"
    },
    "commentParagraphs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "motionLanguageSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["doc", "recipes", "keyframes"],
      "properties": {
        "doc": {
          "$ref": "#/$defs/commentParagraphs"
        },
        "recipes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/recipe"
          }
        },
        "keyframes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframe"
          }
        }
      }
    },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "semantics", "consumer", "reducedMotion"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "semantics": {
          "type": "string"
        },
        "consumer": {
          "type": "string"
        },
        "reducedMotion": {
          "type": "string"
        }
      }
    },
    "keyframe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frames"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "doc": {
          "$ref": "#/$defs/commentParagraphs"
        },
        "frames": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/keyframeFrame"
          }
        }
      }
    },
    "keyframeFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "ops"],
      "properties": {
        "stage": {
          "enum": ["from", "to", "0%", "100%"]
        },
        "ops": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/motionOperation"
          }
        }
      }
    },
    "motionOperation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["op"],
      "properties": {
        "op": {
          "enum": ["opacity", "width", "translate"]
        },
        "value": {
          "type": "number"
        },
        "axis": {
          "enum": ["x", "y"]
        },
        "distanceRef": {
          "$ref": "#/$defs/sourceRef"
        },
        "factor": {
          "type": "number"
        }
      }
    },
    "appearanceProfiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fontSmall",
        "fontLarge",
        "densityCompact",
        "densityComfortable",
        "contentStandard",
        "contentWide",
        "contrastHigh"
      ],
      "properties": {
        "fontSmall": {
          "type": "object",
          "additionalProperties": false,
          "required": ["font-size"],
          "properties": {
            "font-size": {
              "$ref": "#/$defs/cssValue"
            }
          }
        },
        "fontLarge": {
          "type": "object",
          "additionalProperties": false,
          "required": ["font-size"],
          "properties": {
            "font-size": {
              "$ref": "#/$defs/cssValue"
            }
          }
        },
        "densityCompact": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "--spacing-control-sm",
            "--spacing-control",
            "--spacing-control-lg",
            "--radius-control",
            "--radius-panel"
          ],
          "properties": {
            "--spacing-control-sm": {
              "$ref": "#/$defs/cssValue"
            },
            "--spacing-control": {
              "$ref": "#/$defs/cssValue"
            },
            "--spacing-control-lg": {
              "$ref": "#/$defs/cssValue"
            },
            "--radius-control": {
              "$ref": "#/$defs/cssValue"
            },
            "--radius-panel": {
              "$ref": "#/$defs/cssValue"
            }
          }
        },
        "densityComfortable": {
          "type": "object",
          "additionalProperties": false,
          "required": ["--spacing-control-sm", "--spacing-control", "--spacing-control-lg"],
          "properties": {
            "--spacing-control-sm": {
              "$ref": "#/$defs/cssValue"
            },
            "--spacing-control": {
              "$ref": "#/$defs/cssValue"
            },
            "--spacing-control-lg": {
              "$ref": "#/$defs/cssValue"
            }
          }
        },
        "contentStandard": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max-width"],
          "properties": {
            "max-width": {
              "$ref": "#/$defs/cssValue"
            }
          }
        },
        "contentWide": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max-width"],
          "properties": {
            "max-width": {
              "$ref": "#/$defs/cssValue"
            }
          }
        },
        "contrastHigh": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "--spacing-focus-ring-width",
            "--spacing-focus-ring-offset",
            "--motion-opacity-reveal-start"
          ],
          "properties": {
            "--motion-opacity-reveal-start": {
              "$ref": "#/$defs/cssValue"
            },
            "--spacing-focus-ring-width": {
              "$ref": "#/$defs/cssValue"
            },
            "--spacing-focus-ring-offset": {
              "$ref": "#/$defs/cssValue"
            }
          }
        }
      }
    }
  },
  "x-community-go": {
    "protocolVersion": 1,
    "authorityId": "@community-go/design-system",
    "contractRef": {
      "file": "tooling/foundation-contracts.json",
      "pointer": "/contracts/@community-go~1design-system"
    },
    "source": {
      "tokens": {
        "colors": {
          "roleOrder": [
            "canvas",
            "surface",
            "surface-raised",
            "surface-muted",
            "surface-inset",
            "border",
            "border-strong",
            "ink",
            "ink-muted",
            "brand",
            "brand-strong",
            "brand-soft",
            "success",
            "success-soft",
            "warning",
            "warning-soft",
            "danger",
            "danger-soft",
            "info",
            "info-soft",
            "on-brand",
            "on-success",
            "on-warning",
            "on-danger",
            "on-info",
            "focus-ring",
            "scrim"
          ],
          "light": {
            "canvas": "#f6f7fb",
            "surface": "#ffffff",
            "surface-raised": "#ffffff",
            "surface-muted": "#f0f2f7",
            "surface-inset": "#e9ecf3",
            "border": "#e4e7ee",
            "border-strong": "#cfd5df",
            "ink": "#172033",
            "ink-muted": "#596579",
            "brand": "#5d49d6",
            "brand-strong": "#4e3bc3",
            "brand-soft": "#eeebff",
            "success": "#10703f",
            "success-soft": "#e8f7ef",
            "warning": "#b54708",
            "warning-soft": "#fff2df",
            "danger": "#c4323d",
            "danger-soft": "#ffeaec",
            "info": "#2463eb",
            "info-soft": "#e9f0ff",
            "on-brand": "#ffffff",
            "on-success": "#ffffff",
            "on-warning": "#2b1600",
            "on-danger": "#ffffff",
            "on-info": "#ffffff",
            "focus-ring": "#5d49d6",
            "scrim": "rgb(15 23 42 / 0.38)"
          },
          "dark": {
            "canvas": "#0d111c",
            "surface": "#141a27",
            "surface-raised": "#1a2232",
            "surface-muted": "#20293a",
            "surface-inset": "#101622",
            "border": "#273247",
            "border-strong": "#36435b",
            "ink": "#f5f7fb",
            "ink-muted": "#9aa6ba",
            "brand": "#9b8cff",
            "brand-strong": "#b0a5ff",
            "brand-soft": "#29244d",
            "success": "#57d08b",
            "success-soft": "#153827",
            "warning": "#f3b55a",
            "warning-soft": "#3d2d18",
            "danger": "#ff7a86",
            "danger-soft": "#422129",
            "info": "#78a5ff",
            "info-soft": "#192d55",
            "on-brand": "#17122d",
            "on-success": "#082416",
            "on-warning": "#2a1800",
            "on-danger": "#2d1015",
            "on-info": "#0b1b3a",
            "focus-ring": "#b0a5ff",
            "scrim": "rgb(0 0 0 / 0.58)"
          }
        },
        "accents": {
          "order": ["purple", "blue", "green", "orange"],
          "roles": ["brand", "brand-strong", "brand-soft", "on-brand", "focus-ring"],
          "palettes": {
            "purple": {
              "light": {
                "brand": "#5d49d6",
                "brand-strong": "#4e3bc3",
                "brand-soft": "#eeebff",
                "on-brand": "#ffffff",
                "focus-ring": "#5d49d6"
              },
              "dark": {
                "brand": "#9b8cff",
                "brand-strong": "#b0a5ff",
                "brand-soft": "#29244d",
                "on-brand": "#17122d",
                "focus-ring": "#b0a5ff"
              }
            },
            "blue": {
              "light": {
                "brand": "#2563eb",
                "brand-strong": "#1e40af",
                "brand-soft": "#e9f0ff",
                "on-brand": "#ffffff",
                "focus-ring": "#2563eb"
              },
              "dark": {
                "brand": "#8ab0ff",
                "brand-strong": "#a5c3ff",
                "brand-soft": "#1c2d52",
                "on-brand": "#17122d",
                "focus-ring": "#8ab0ff"
              }
            },
            "green": {
              "light": {
                "brand": "#047857",
                "brand-strong": "#065f46",
                "brand-soft": "#e4f5ee",
                "on-brand": "#ffffff",
                "focus-ring": "#047857"
              },
              "dark": {
                "brand": "#5fd0a8",
                "brand-strong": "#7de0ba",
                "brand-soft": "#12382b",
                "on-brand": "#17122d",
                "focus-ring": "#5fd0a8"
              }
            },
            "orange": {
              "light": {
                "brand": "#c2410c",
                "brand-strong": "#9a3412",
                "brand-soft": "#ffecdf",
                "on-brand": "#ffffff",
                "focus-ring": "#c2410c"
              },
              "dark": {
                "brand": "#fdab6d",
                "brand-strong": "#febf8f",
                "brand-soft": "#45230f",
                "on-brand": "#17122d",
                "focus-ring": "#fdab6d"
              }
            }
          }
        },
        "theme": {
          "fontSans": "'Inter Variable', Inter, ui-sans-serif, system-ui, sans-serif",
          "radii": {
            "control": "0.75rem",
            "panel": "1rem",
            "shell": "1.25rem"
          },
          "spacings": {
            "control-sm": "2.25rem",
            "control": "2.75rem",
            "control-lg": "3rem",
            "progress-bar": "0.1875rem",
            "icon-sm": "1rem",
            "icon": "1.25rem",
            "icon-lg": "1.5rem",
            "option": "2.5rem",
            "overlay": "18rem",
            "focus-ring-width": "0.125rem",
            "focus-ring-offset": "0.125rem"
          },
          "shadows": {
            "panel": "0 1px 2px rgb(15 23 42 / 0.04), 0 12px 32px rgb(15 23 42 / 0.06)",
            "overlay": "0 24px 64px rgb(15 23 42 / 0.18)"
          },
          "easeProduct": "cubic-bezier(0.2, 0.8, 0.2, 1)",
          "defaultTransitionDuration": {
            "ref": "/x-community-go/source/tokens/rootMotion/durationPurpose/refs/control",
            "doc": "未显式 duration 的 transition-* 统一归 control 语义"
          },
          "transitionDurations": {
            "fast": {
              "ref": "/x-community-go/source/tokens/rootMotion/durationBase/fast"
            },
            "standard": {
              "ref": "/x-community-go/source/tokens/rootMotion/durationBase/standard"
            },
            "slow": {
              "ref": "/x-community-go/source/tokens/rootMotion/durationBase/slow"
            },
            "page": {
              "ref": "/x-community-go/source/tokens/rootMotion/durationPurpose/refs/page"
            }
          },
          "zIndices": {
            "shell": "20",
            "sticky": "30",
            "overlay": "50",
            "toast": "60"
          }
        },
        "rootMotion": {
          "debugScale": {
            "doc": ["Motion Inspector 只调整调试倍率，基础档位仍是唯一数值权威。"],
            "value": "1"
          },
          "delayRoute": {
            "doc": [
              "Route content.enter 的前置 delay：方向进入无旧内容快照等待（纯 CSS 驱动），",
              "与 content 档一致，保证页面切换响应快；方向感由位移本身表达。"
            ],
            "values": {
              "forward": {
                "ref": "/x-community-go/source/tokens/rootMotion/durationPurpose/refs/feedback"
              },
              "content": {
                "ref": "/x-community-go/source/tokens/rootMotion/durationPurpose/refs/feedback"
              }
            }
          },
          "delayReveal": {
            "step": "40ms",
            "max": "120ms"
          },
          "revealOpacity": "0.96",
          "durationBase": {
            "fast": "120ms",
            "standard": "180ms",
            "slow": "240ms"
          },
          "durationPurpose": {
            "doc": [
