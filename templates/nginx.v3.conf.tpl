# Generated by nodectl; edit node.toml and render a new release.
user {{ NGINX_USER }};
worker_processes auto;
pid /run/nginx.pid;
error_log {{ LOG_ROOT }}/nginx/error.log warn;
events { worker_connections 4096; }
http {
    types {
        text/html html htm;
        text/css css;
        application/javascript js mjs;
        application/json json;
        image/svg+xml svg;
        image/png png;
        image/jpeg jpg jpeg;
        image/x-icon ico;
        font/woff2 woff2;
        text/plain txt;
    }
    default_type application/octet-stream;
    {{ SHARE_LOG_FORMAT }}
    access_log {{ LOG_ROOT }}/nginx/access.log {{ SHARE_LOG_TYPE }};
    {{ SHARE_LIMIT }}
    sendfile on;
    ssl_protocols TLSv1.3;
    http2 on;
    {{ HTTP3 }}
    server {
{{ HTTP_LISTEN }}
        server_name _;
        {{ SHARE_HTTP }}
        location ^~ /.well-known/acme-challenge/ { root /var/www/acme; }
        location / { return 301 https://$host{{ REDIRECT_PORT }}$request_uri; }
    }
    server {
{{ DEFAULT_LISTEN }}
        server_name _;
        {{ SHARE_ERROR }}
        {{ SHARE_IP }}
        ssl_certificate {{ IP_CERT }}/fullchain.pem;
        ssl_certificate_key {{ IP_CERT }}/privkey.pem;
        {{ ALT_SVC }}
        location / {
            root {{ WEB_ROOT }};
            index index.html;
            try_files $uri $uri/ /index.html;
        }
    }
    server {
{{ DOMAIN_LISTEN }}
        server_name {{ DOMAINS }};
        {{ SHARE_ERROR }}
        {{ SHARE_ROUTE }}
        ssl_certificate {{ DOMAIN_CERT }}/fullchain.pem;
        ssl_certificate_key {{ DOMAIN_CERT }}/privkey.pem;
        {{ ALT_SVC }}
        location ^~ {{ XHTTP_PATH }} {
            client_max_body_size 0;
            client_body_timeout 1h;
            grpc_read_timeout 1h;
            grpc_send_timeout 1h;
            grpc_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            grpc_set_header X-Real-IP $remote_addr;
            grpc_pass unix:{{ XHTTP_SOCKET }};
        }
        location = {{ WS_PATH }} {
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_read_timeout 1h;
            proxy_send_timeout 1h;
            proxy_buffering off;
            proxy_request_buffering off;
            proxy_pass http://unix:{{ WS_SOCKET }}:;
        }
        location / {
            root {{ WEB_ROOT }};
            index index.html;
            try_files $uri $uri/ /index.html;
        }
    }
}
